{
  "name": "lens-chatbot",
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"if(+process.versions.node.split('.')[0]<22){console.error('ERROR: Node 22+ required (found '+process.version+')');process.exit(1)}\"",
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx src/index.ts",
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-sqlite tsx --test src/services/llmSanitize.test.ts src/services/workspaceExplorer.test.ts src/services/workspacePaths.test.ts src/services/agentReports.test.ts src/db.agentSettings.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "prompts:check": "node scripts/check-prompts.mjs",
    "prompts:sync-cline-system": "node scripts/sync-cline-system-prompts.mjs",
    "prompts:check-cline-system": "node scripts/sync-cline-system-prompts.mjs --check"
  },
  "dependencies": {
    "@cline/sdk": "latest",
    "@types/multer": "^2.1.0",
    "axios": "^1",
    "dotenv": "^16",
    "express": "^4",
    "multer": "^2.1.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/express": "^4",
    "@types/node": "^22",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4",
    "typescript": "^5"
  }
}
