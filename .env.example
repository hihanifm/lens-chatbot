# LLM — Ollama (default)
# host.docker.internal reaches Ollama on the host from inside the container
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
# For internal OpenAI-compatible API: LLM_PROVIDER=litellm (or openrouter, deepseek, etc.)
BUG_TRACKER_URL=https://your-tracker/api
BUG_TRACKER_TOKEN=your-tracker-token
PORT=3000

# Log level — controls server verbosity (debug|info|warn|error), default: info
# Use debug to trace SSE lifecycle, agent tool calls, and zip extraction state
LOG_LEVEL=info

# Admin PIN — seeds the settings admin PIN on first startup (hashed + stored in DB; env var is ignored after that)
ADMIN_PIN=changeme

# Docker — proxy (set if your lab blocks direct egress)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# Docker — override base image registry if ECR is unreachable
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim

# Wiki — troubleshooting knowledge base (default: DATA_DIR/wiki); mount separately in Docker for shared access
# WIKI_DIR=/app/wiki

# Agent skills directories — colon-separated list of folders containing .md skill files
# /app/skills is the built-in default (baked into the image)
# Add more paths to layer in team or project-specific skills
# SKILLS_DIR=/app/skills:/mnt/team-skills:/mnt/java-squad-skills

# User skills directory — Docker only: maps a host folder into the container at /mnt/user-skills
# Then add /mnt/user-skills via the settings UI (Skills Directories section)
# For make dev (plain Node), skip this and enter the host path directly in the settings UI
# USER_SKILLS_DIR=/path/to/your/skills/folder

# Docker — override ports (default: dev=38001, prod=38000)
# DEV_PORT=38001
# PROD_PORT=38000
