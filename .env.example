# LLM — Ollama (default, OpenAI-compatible)
# host.docker.internal reaches Ollama on the host from inside the container
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
BUG_TRACKER_URL=https://your-tracker/api
BUG_TRACKER_TOKEN=your-tracker-token
PORT=3000

# Docker — proxy (set if your lab blocks direct egress)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# Docker — override base image registry if ECR is unreachable
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim

# Docker — override ports (default: dev=38001, prod=38000)
# DEV_PORT=38001
# PROD_PORT=38000
